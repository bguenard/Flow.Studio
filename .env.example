# BACKEND ONLY. Never expose these values in frontend build variables.
GENESYS_REGION=eu-west-1
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
# Required comma-separated table IDs from the target organization; no wildcard.
GENESYS_ALLOWED_TABLE_IDS=
# Optional extra restriction by exact table names. All allowed names must start W_.
GENESYS_ALLOWED_TABLE_NAMES=W_INBOUND_CALL_v5,W_SERVICES_v5,W_MENU_v5,W_SCHEDULE_GROUP_v5,W_PARTICIPANT_DATA_v5,W_DECISION_v5
GENESYS_MAX_PAGES=100
GENESYS_TIMEOUT_MS=10000
# API Gateway must validate JWT issuer/audience before invoking Lambda.
AUTH_ROLE_CLAIM=cognito:groups
AUTH_READ_ROLE=wolf-reader
# Optional fixed tenant claim restriction, in addition to the fixed Genesys organization.
AUTH_TENANT_CLAIM=tenant_id
AUTH_TENANT_ID=
# Exact frontend origin, no wildcard. Set CORS OPTIONS in API Gateway too.
ALLOWED_ORIGIN=
